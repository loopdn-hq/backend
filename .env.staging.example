# Copy to .env.staging and fill in. Never commit the real file.

# --- Django --------------------------------------------------------------
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
# Signs JWTs. Separate from SECRET_KEY so rotating one does not sign
# everybody out of the app.
JWT_SIGNING_KEY=change-me-to-a-different-long-random-string

# Comma-separated. Required when DEBUG=False - and websocket handshakes are
# refused unless the origin's host is listed here.
ALLOWED_HOSTS=api-staging.loopdn.com,localhost,127.0.0.1

# Browser origins permitted to call this API, comma-separated.
CORS_ALLOWED_ORIGINS=https://staging.loopdn.com

# --- Email verification --------------------------------------------------
# On by default. Registering emails a code and login is refused until
# /verify-email/ confirms it. Set to False to have registration mark the
# account verified on the spot, so it can sign in immediately.
REQUIRE_EMAIL_VERIFICATION=True

# --- Email (Resend) ------------------------------------------------------
# Templates are rendered here, from templates/email/, and the finished message
# is POSTed to Resend - we do not use Resend's dashboard templates. See the
# header of utils/mail.py for why.
#
# Leave RESEND_API_KEY blank in development: utils/mail.py then renders the
# message and logs it instead of sending, so the flow works with no account.
RESEND_API_KEY=

# The From: on every message. Its domain must be verified in the Resend
# dashboard or every send comes back 403.
DEFAULT_FROM_EMAIL=no-reply@loopdn.com

# Injected into every email template without the caller passing them.
EMAIL_PRODUCT_NAME=Loopd
EMAIL_SUPPORT_ADDRESS=support@loopdn.com

# --- group email (the mail app) ------------------------------------------
#
# A delivery channel, not transactional mail: this is the conversation itself
# reaching members who take part by email. Off by default, because switching a
# channel on for every existing group is a decision to make on purpose - and a
# sending domain's reputation is not recoverable by turning it back off.
MAIL_SENDING_ENABLED=False

# The domain the inbound provider receives replies on. Every address under it
# is a machine-readable reply handle, so it must NOT be the domain that takes
# ordinary mail for the company. Blank means replies are not accepted, and the
# templates then say "open Loopd to respond" rather than inviting one.
MAIL_REPLY_DOMAIN=

# Signs the inbound email webhook, from the provider's dashboard. Blank skips
# verification - development only. Setting MAIL_REPLY_DOMAIN without this is a
# deploy-blocking error (mail.E001): the webhook posts into private groups and
# the signature is the only thing authenticating it.
RESEND_WEBHOOK_SECRET=

# Where the frontend lives; reset links are built as
# ${FRONTEND_URL}/reset-password?uid=...&token=...
FRONTEND_URL=https://loopdn.com

# How long a password reset link stays valid, in seconds.
PASSWORD_RESET_TIMEOUT_SECONDS=1800

# Rate limits forgot-password per email address, so it cannot be used to spam
# an inbox with reset links. Cooldown stops an immediate double-submit; the
# hourly ceiling stops a slow drip that waits the cooldown out each time.
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=3

# --- Postgres ------------------------------------------------------------
# Read by both the db container (to create the database) and Django.
POSTGRES_DB=loopd
POSTGRES_USER=loopd
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---------------------------------------------------------------
# Database 0 carries realtime chat between workers (Channels).
REDIS_URL=redis://redis:6379/0

# Database 1 for Celery, so a `FLUSHDB` on one never drops the other.
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- SMS / phone verification (Telnyx Verify) ----------------------------
# We use the Telnyx **Verify** API, not the Messages API: Telnyx generates,
# sends, stores and checks the OTP, so this project never holds an SMS code.
# See the header of sms/verification.py for why.
#
# Leave both blank in development - sms/verification.py then logs instead of sending
# and accepts the code 000000, so the flow works with no account.
TELNYX_API_KEY=
# The Verify profile, not a messaging profile. A UUID from the Telnyx portal.
TELNYX_VERIFY_PROFILE_ID=

# Country prefixes we are willing to text, comma-separated. The main defence
# against SMS pumping - fraud where an attacker points verification at a
# premium-rate number they control and takes a cut of the charge. Empty means
# no restriction; widen it before launching in a new market or verification
# silently fails there.
SMS_ALLOWED_COUNTRY_PREFIXES=+63,+1

# --- Group numbers -------------------------------------------------------
# Buy every group's number in this country, whatever the creator's country is.
# 'US' while group SMS is being tested: Telnyx sells no SMS-capable number in
# PH, GB, AU or SG (a search there answers HTTP 400 'No coverage found' - the
# numbers that exist are voice/fax only), so US and CA are the only countries
# the feature can be exercised in. Leave EMPTY in production, where the
# creator's own country decides.
SMS_FORCE_COUNTRY=US

# Countries to try when the wanted one has nothing. Deliberately EMPTY: a group
# that cannot get a number in its own country gets NO number rather than a
# foreign one, because the number can never be changed afterwards and every
# member would pay international rates to text it.
SMS_FALLBACK_COUNTRIES=

# --- OTP limits ----------------------------------------------------------
# The cooldown stops bursts; the ceilings stop a slow drip. Both are enforced
# per account AND per destination number - see otp/services.py.
OTP_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_SENDS_PER_DAY=10

# --- Google sign-in -----------------------------------------------------
# The web client obtains an ID token from Google; Django verifies it against
# this OAuth client ID. A client secret is not used or needed by this flow.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Stripe (payments and webhooks) -------------------------------------- 
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret