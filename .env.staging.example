# Copy to .env.staging and fill in. Never commit the real file.

# --- Django --------------------------------------------------------------
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
# Signs JWTs. Separate from SECRET_KEY so rotating one does not sign
# everybody out of the app.
JWT_SIGNING_KEY=change-me-to-a-different-long-random-string

# Comma-separated. Required when DEBUG=False - and websocket handshakes are
# refused unless the origin's host is listed here.
ALLOWED_HOSTS=api-staging.loopdn.com,localhost,127.0.0.1

# Browser origins permitted to call this API, comma-separated.
CORS_ALLOWED_ORIGINS=https://staging.loopdn.com

DEFAULT_FROM_EMAIL=no-reply@loopdn.com

# --- Postgres ------------------------------------------------------------
# Read by both the db container (to create the database) and Django.
POSTGRES_DB=loopd
POSTGRES_USER=loopd
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---------------------------------------------------------------
# Database 0 carries realtime chat between workers (Channels).
REDIS_URL=redis://redis:6379/0

# Database 1 for Celery, so a `FLUSHDB` on one never drops the other.
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1
