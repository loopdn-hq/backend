# Copy to .env.staging and fill in. Never commit the real file.

# --- Django --------------------------------------------------------------
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
# Signs JWTs. Separate from SECRET_KEY so rotating one does not sign
# everybody out of the app.
JWT_SIGNING_KEY=change-me-to-a-different-long-random-string

# Comma-separated. Required when DEBUG=False - and websocket handshakes are
# refused unless the origin's host is listed here.
ALLOWED_HOSTS=api-staging.loopdn.com,localhost,127.0.0.1

# Browser origins permitted to call this API, comma-separated.
CORS_ALLOWED_ORIGINS=https://staging.loopdn.com

DEFAULT_FROM_EMAIL=no-reply@loopdn.com

# --- Postgres ------------------------------------------------------------
# Read by both the db container (to create the database) and Django.
POSTGRES_DB=loopd
POSTGRES_USER=loopd
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---------------------------------------------------------------
# Database 0 carries realtime chat between workers (Channels).
REDIS_URL=redis://redis:6379/0

# Database 1 for Celery, so a `FLUSHDB` on one never drops the other.
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- SMS / phone verification (Telnyx Verify) ----------------------------
# We use the Telnyx **Verify** API, not the Messages API: Telnyx generates,
# sends, stores and checks the OTP, so this project never holds an SMS code.
# See the header of utils/sms.py for why.
#
# Leave both blank in development - utils/sms.py then logs instead of sending
# and accepts the code 000000, so the flow works with no account.
TELNYX_API_KEY=
# The Verify profile, not a messaging profile. A UUID from the Telnyx portal.
TELNYX_VERIFY_PROFILE_ID=

# Country prefixes we are willing to text, comma-separated. The main defence
# against SMS pumping - fraud where an attacker points verification at a
# premium-rate number they control and takes a cut of the charge. Empty means
# no restriction; widen it before launching in a new market or verification
# silently fails there.
SMS_ALLOWED_COUNTRY_PREFIXES=+63,+1

# --- OTP limits ----------------------------------------------------------
# The cooldown stops bursts; the ceilings stop a slow drip. Both are enforced
# per account AND per destination number - see otp/services.py.
OTP_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_SENDS_PER_DAY=10

# --- Google sign-in -----------------------------------------------------
# The web client obtains an ID token from Google; Django verifies it against
# this OAuth client ID. A client secret is not used or needed by this flow.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
